# =============================================================================
# GuardianOps — Variáveis de Ambiente e Configuração Geral (.env)
# =============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente:
# cp .env.example .env
# =============================================================================

# ── 1. Conexão com o Jira ───────────────────────────────────────────────────
# URL base do seu servidor Jira (ex: https://jira.suaempresa.com ou Atlassian Cloud)
JIRA_BASE_URL=https://jira.suaempresa.com

# Usuário ou e-mail de serviço para abertura dos chamados
JIRA_USER=guardian.ops

# Senha ou Personal Access Token (PAT) da conta de serviço
JIRA_PASSWORD=seu_token_ou_senha_aqui

# Chave padrão do projeto Jira de destino (ex: OPS, SRE, INFRA, DEVOPS)
JIRA_PROJECT_KEY=OPS

# Tipo de issue padrão para incidentes criados automaticamente (ex: Incident, Bug, Task)
JIRA_ISSUE_TYPE=Incident

# (Opcional) ID de campo customizado corporativo de contrato ou SLA
# Se não utilizado pela sua organização, mantenha em branco
JIRA_CUSTOMFIELD_CONTRATO_ID=
JIRA_CONTRATO_DEFAULT=

# ── 2. Parâmetros Operacionais ──────────────────────────────────────────────
# Porta HTTP do servidor Web e API REST (padrão: 8080)
PORT=8080

# Modo Dry-Run (true = apenas gera diagnósticos e RCA sem enviar chamados ao Jira)
GUARDIAN_DRY_RUN=false

# Janela de supressão de anti-spam/deduplicação para o mesmo incidente (em minutos)
GUARDIAN_COOLDOWN_MINUTES=60

# ── 3. Conectividade de Infraestrutura ──────────────────────────────────────
# Caminho do kubeconfig (se omitido, busca automaticamente em ~/.kube/config)
# KUBECONFIG=/caminho/do/seu/kubeconfig

# Endpoint padrão do Docker (se omitido, usa /var/run/docker.sock)
# DOCKER_HOST=/var/run/docker.sock
# DOCKER_HOST=tcp://192.168.1.100:2375
